      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fecha de mañana para los eventos futuros",
          "const manana = new Date(Date.now() + 24 * 60 * 60 * 1000);",
          "pm.collectionVariables.set('fechaManana', manana.toISOString());"
        ]
      }
    }
  ]
}